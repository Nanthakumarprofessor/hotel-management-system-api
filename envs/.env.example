# =============================================================================
# Hotel Management System API - Environment Configuration Template
# =============================================================================
# Copy this file to envs/.env.dev (or envs/.env.prod, etc.) and fill in values.
# NEVER commit real credentials to version control.
# =============================================================================

# Server Configuration
PORT=8080

# Database Configuration (PostgreSQL)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=disable
DATABASE_URL=postgres://postgres:password@localhost:5432/hotel_management_db?sslmode=disable

# Project root used to resolve docs/ and static assets
PROJECT_ROOT=.

# Base URL used for OpenAPI spec server substitution
BASE_URL=http://localhost:8080

# Logger Configuration
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info
LOG_DIR=./logs
LOG_FILE_NAME=hotel-management-system.log
